FROM python:3.12-slim

# Install system dependencies and curl for uv setup
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv natively for lightning-fast package builds
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

WORKDIR /app

# Copy dependency configuration files and compile environment using uv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

# Copy the entire RAG codebase into the container
COPY . .

# Hugging Face Spaces strictly routes inbound web traffic through port 7860
EXPOSE 7860

# Create a shell script to run both FastAPI (port 8000) and Streamlit (port 7860) simultaneously
RUN echo '#!/bin/bash\n\
uv run uvicorn main:app --host 127.0.0.1 --port 8000 &\n\
uv run streamlit run frontend.py --server.port 7860 --server.address 0.0.0.0 --server.fileWatcherType none\n\
wait -n\n\
' > start.sh && chmod +x start.sh

CMD ["./start.sh"]